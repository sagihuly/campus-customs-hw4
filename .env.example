# Set these in the backend process environment; the app does not load .env automatically.
# Required for live chat requests through Portkey. Keep the real value private.
PORTKEY_API_KEY=your-portkey-api-key

# Optional model routing overrides. Defaults: gpt-6-luna and openai.
PORTKEY_MODEL=gpt-6-luna
PORTKEY_PROVIDER=openai
# PORTKEY_BASE_URL=

# Optional session settings. Use a long random value for stable sessions.
CAMPUS_CUSTOMS_SESSION_SECRET=replace-with-a-long-random-secret
CAMPUS_CUSTOMS_COOKIE_SECURE=false
